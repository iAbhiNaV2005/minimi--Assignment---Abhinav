# ========================================================
# Minimi Autonomous Chat Agent - Environment Configuration
# ========================================================

# Google Gemini API Key (100% Free tier from https://aistudio.google.com/)
# Used for neural intent synthesis, query decomposition, and delta comparative auditing.
# Note: If omitted, agent runs with deterministic factual synthesis.
GEMINI_API_KEY=

# Tavily AI Search API Key (Optional free tier 1,000 queries/month at https://tavily.com/)
# If omitted or exhausted, system automatically falls back to DuckDuckGo zero-key scraper.
TAVILY_API_KEY=

# Port configuration (Defaults to 3000)
PORT=3000

